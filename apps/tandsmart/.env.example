# Tandsmart — copy to apps/tandsmart/.env.local
# Use a SEPARATE Supabase project from Erfar (region eu-north-1, Stockholm): this app stores health data.
NEXT_PUBLIC_SUPABASE_URL=https://your-tandsmart-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

NEXT_PUBLIC_APP_URL=https://www.tandsmart.se

# Email notifications (optional — without a key nothing is emailed).
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=Tandsmart <noreply@tandsmart.se>
# Where "new case" / "new message" notifications go (Sylvia).
TANDSMART_REVIEWER_EMAIL=sylvia@tandsmart.se

# AI pre-analysis for the reviewing dentist (optional). Only enable once a
# DPA with Anthropic is in place and the privacy policy covers it.
TANDSMART_AI_ENABLED=false
ANTHROPIC_API_KEY=your-anthropic-api-key

# Company facts for the clinic review via apiverket.se (optional).
COMPANY_LOOKUP_API_KEY=your-apiverket-api-key
